<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.cliftonboyd2007.audiobug</id>

    <name>AudioBug</name>
    <version>0.3-beta9</version>

    <vendor url="https://github.com/CliftonBoyd2007/AudioBug"/>

    <description>
        AudioBug provides auditory and spoken feedback for diagnostics in the editor to those who are blind or visually
        impaired.
        Speech and audio when the caret enters a line with errors or warnings.
        Read error/warning messages out loud on-demand.


    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.cliftonboyd2007.audiobug.core.AudioBug_Init"/>
    </extensions>

    <actions>
        <action id="com.cliftonboyd2007.audiobug.core.actions.ReadHighlightDescriptionAction"
                class="com.cliftonboyd2007.audiobug.core.actions.ReadHighlightDescriptionAction"
        >
            <keyboard-shortcut keymap="$default" first-keystroke="alt P"/>
        </action>
        <action id="com.cliftonboyd2007.audiobug.core.actions.ReadCurrentLineNumberAction"
                class="com.cliftonboyd2007.audiobug.core.actions.ReadCurrentLineNumberAction"
                text="Announce Line Number"
                description="Announces the number of the line on which the cursor is located.">
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt G"/>
        </action>
        <action id="com.cliftonboyd2007.audiobug.core.actions.ReadPsiElementActionPrototype"
                class="com.cliftonboyd2007.audiobug.core.actions.ReadPsiElementActionPrototype"
                text="Read PSI Element At Caret"
                description="Announce the PSI element under the caret with the active screen reader. This is a prototype; this is not to remain in a public release.">
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt SPACE"/>
        </action>
    </actions>
    <!--    <resource-bundle>messages.MyMessageBundle</resource-bundle>-->
</idea-plugin>
