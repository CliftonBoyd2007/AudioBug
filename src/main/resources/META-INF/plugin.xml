<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.CliftonBoyd2007.AudioBug</id>

    <name>AudioBug</name>
    <version>0.1.5</version>

    <vendor url="https://github.com/CliftonBoyd2007/AudioBug"/>

    <description>
        AudioBug provides auditory and spoken feedback for diagnostics in the editor to those who are blind or visually
        impaired.
        Speech and audio when the caret enters a line with errors or warnings.
        Read error/warning messages out loud on-demand.


    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.CliftonBoyd2007.AudioBug.core.AudioBug_Init"/>
    </extensions>

    <actions>
        <action id="com.CliftonBoyd2007.AudioBug.core.actions.ReadHighlightDescriptionAction"
                class="com.CliftonBoyd2007.AudioBug.core.actions.ReadHighlightDescriptionAction"
                text="Read Highlight Description"
                description="Verbally read the message in the highlight on the current line.">
            <keyboard-shortcut keymap="$default" first-keystroke="alt R"/>
        </action>
    </actions>
</idea-plugin>
